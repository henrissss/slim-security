# Copy this file to .env and fill in real values.
# Never commit your real .env file to version control.

PORT=4242

# --- Stripe ---
# Get these from https://dashboard.stripe.com/test/apikeys (use test keys first)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# From https://dashboard.stripe.com/test/webhooks after you create an endpoint pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Plaid ---
# Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
# sandbox | development | production
PLAID_ENV=sandbox

# --- App ---
# Base URL where this site is served from (used for Apple Pay domain checks, CORS, etc.)
APP_BASE_URL=http://localhost:4242
